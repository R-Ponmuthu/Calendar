<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.fragments.PoruthamFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/male"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/ic_keyboard_arrow_down"
            android:focusable="false"
            android:hint="ஆண் ராசி நட்சத்திரம்"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:backgroundTint="@color/blue" />

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/female"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawableRight="@drawable/ic_keyboard_arrow_down"
            android:focusable="false"
            android:hint="பெண் ராசி நட்சத்திரம்"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:backgroundTint="@color/blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/pink" />

            <TextView
                android:id="@+id/porutham"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:gravity="right"
                android:text=""
                android:textColor="@color/pink" />

        </LinearLayout>

        <TextView
            android:id="@+id/porundhumNatchathiram"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@color/pink"
            android:gravity="center"
            android:text="பொருந்தும் நட்சத்திரங்கள்"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

    <ExpandableListView
        android:id="@+id/expandableListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:childDivider="@color/blue"
        android:dividerHeight="1dp"
        android:groupIndicator="@null" />

</LinearLayout>