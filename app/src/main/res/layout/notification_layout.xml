<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/subamuhurtham" />

        <TextView
            android:id="@+id/current_date"
            android:layout_width="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/logo"
            android:padding="5dp"
            android:text="Current Date"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tamil_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/current_date"
            android:layout_toRightOf="@+id/logo"
            android:padding="5dp"
            android:text="Tamil Date"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nallaNeram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tamil_date"
            android:layout_toRightOf="@+id/logo"
            android:padding="5dp"
            android:text="Tamil Date"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/dat_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="16dp"
            android:src="@drawable/ic_down_arrow" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/muhurtham"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="16dp"
            android:src="@drawable/subamuhurtham" />

        <ImageView
            android:id="@+id/amavasai"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="16dp"
            android:src="@drawable/icons_amavasai" />

        <ImageView
            android:id="@+id/pournami"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="16dp"
            android:src="@drawable/icons_pournami" />

    </LinearLayout>

    <TextView
        android:id="@+id/viradham"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/current_date"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="10dp"
        android:padding="5dp"
        android:text=""
        android:textColor="@color/black"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/festivals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/current_date"
        android:layout_marginLeft="10dp"
        android:padding="5dp"
        android:text=""
        android:textColor="@color/black"
        android:textSize="15sp" />

</LinearLayout>