<?xml version="1.0" encoding="utf-8"?>
<com.it.calendar.calendarview.helpers.FrameRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="2dp"
    android:background="@color/white"
    app:frame_color="@android:color/transparent"
    app:frame_width="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="15dp">

        <TextView
            android:id="@+id/tam_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:paddingTop="3dp"
            android:layout_centerHorizontal="true"
            android:text=""
            android:textColor="@color/blue"
            android:textSize="9sp"
            android:visibility="gone" />

        <!--<TextView
            android:id="@+id/tam_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="3dp"
            android:text="1"
            android:textColor="@color/tamilDate"
            android:textSize="9sp" />-->

    </RelativeLayout>

    <com.it.calendar.calendarview.helpers.SelectedTextView
        android:id="@+id/tam_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tv_calendar_day"
        android:layout_toRightOf="@+id/tv_calendar_day"
        android:text="30"
        android:textColor="@color/orange"
        android:textSize="9sp" />

    <com.it.calendar.calendarview.helpers.SelectedTextView
        android:id="@+id/tv_calendar_day"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:textSize="14sp"
        app:selected_padding="2dp"
        tools:enable="true"
        tools:text="14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/amavasai"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/icons_amavasai"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pournami"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/icons_pournami"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/muhurtham"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/subamuhurtham"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/kiruthigai"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_kiruthigai" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/astami"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_astami" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navami"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_navami" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pradhosam"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_pirathoosam"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chathurthi"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_chaturthi"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/schathurthi"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_schathurti"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sasti"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_shasti"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/yekadhesi"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_yekadhesi"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/shiva"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_shiva" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:orientation="horizontal">

    </LinearLayout>

</com.it.calendar.calendarview.helpers.FrameRelativeLayout>